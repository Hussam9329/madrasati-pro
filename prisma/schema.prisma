// Prisma schema for madrasati-pro
// Target: Neon serverless Postgres
// All column names use camelCase to match the existing Supabase schema
// (the previous data layer was a Supabase REST client that used camelCase
// columns directly). Using camelCase here means the @map/@db conventions
// are kept minimal — column names in the new Neon schema will be camelCase
// just like the old Supabase schema, so the snapshot JSON imported via
// /api/database/import will map cleanly.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// In Prisma 7+, datasource URL is configured in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ─── Admins ─────────────────────────────────────────────────────────────

model Admin {
  id            String  @id @default(cuid())
  username     String   @unique
  passwordHash String
  isRoot       Boolean? @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AdminSession[]

  @@map("admins")
}

// ─── Admin Sessions (revocable JWT sessions) ────────────────────────────

model AdminSession {
  id            String  @id @default(cuid())
  adminId   String
  jti       String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([revokedAt])
  @@map("admin_sessions")
}

// ─── School Classes ─────────────────────────────────────────────────────

model SchoolClass {
  id            String  @id @default(cuid())
  name        String
  level       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections       Section[]
  classSubjects  ClassSubject[]
  feeSettings    ClassFeeSetting[]

  @@map("school_classes")
}

// ─── Subjects ───────────────────────────────────────────────────────────

model Subject {
  id            String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classSubjects   ClassSubject[]
  teacherSubjects TeacherSubject[]
  schedules       Schedule[]
  exams           Exam[]
  grades          Grade[]

  @@map("subjects")
}

// ─── Sections (within a class) ──────────────────────────────────────────

model Section {
  id            String  @id @default(cuid())
  name        String
  capacity    Int?
  description String?
  isActive    Boolean  @default(true)
  classId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class            SchoolClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  students         Student[]
  teacherSections  TeacherSection[]
  schedules        Schedule[]
  exams            Exam[]

  @@map("sections")
}

// ─── Class ↔ Subject join ───────────────────────────────────────────────

model ClassSubject {
  id            String  @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// ─── Teachers ───────────────────────────────────────────────────────────

model Teacher {
  id            String  @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  address   String?
  specialty String?
  salary    Decimal? @db.Decimal(12, 2)
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherSubjects TeacherSubject[]
  teacherSections TeacherSection[]
  schedules       Schedule[]
  exams           Exam[]
  grades          Grade[]

  @@map("teachers")
}

// ─── Teacher ↔ Subject join ─────────────────────────────────────────────

model TeacherSubject {
  id            String  @id @default(cuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

// ─── Teacher ↔ Section join ─────────────────────────────────────────────

model TeacherSection {
  id            String  @id @default(cuid())
  teacherId String
  sectionId String
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionId])
  @@map("teacher_sections")
}

// ─── Students ───────────────────────────────────────────────────────────

model Student {
  id            String  @id @default(cuid())
  fullName          String
  studentCode       String?  @unique
  gender            String?
  birthDate         DateTime?
  phone             String?
  guardianName      String?
  guardianPhone     String?
  guardianTelegram  String?
  address           String?
  enrollmentDate    DateTime @default(now())
  status            String   @default("active")
  notes             String?
  sectionId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  section           Section?           @relation(fields: [sectionId], references: [id])
  attendanceRecords AttendanceRecord[]
  grades            Grade[]
  payments          Payment[]

  @@index([sectionId])
  @@index([status])
  @@index([guardianTelegram])
  @@map("students")
}

// ─── Schedules ──────────────────────────────────────────────────────────

model Schedule {
  id            String  @id @default(cuid())
  sectionId String
  subjectId String?
  teacherId String?
  day       String?
  startTime String?
  endTime   String?
  room      String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  section           Section?           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject           Subject?           @relation(fields: [subjectId], references: [id])
  teacher           Teacher?           @relation(fields: [teacherId], references: [id])
  attendanceRecords AttendanceRecord[]

  @@map("schedules")
}

// ─── Attendance Records ─────────────────────────────────────────────────

model AttendanceRecord {
  id            String  @id @default(cuid())
  date       DateTime
  mode       String?
  status     String
  notes      String?
  checkInAt  DateTime?
  checkOutAt DateTime?
  source     String?
  studentId  String
  scheduleId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  student  Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([studentId, date])
  @@index([date, checkInAt, checkOutAt])
  @@map("attendance_records")
}

// ─── Exams ──────────────────────────────────────────────────────────────

model Exam {
  id            String  @id @default(cuid())
  name       String
  type       String    @default("daily")
  date       DateTime  @default(now())
  maxScore   Decimal   @default(100) @db.Decimal(8, 2)
  passScore  Decimal   @default(50)  @db.Decimal(8, 2)
  failScore  Decimal?  @db.Decimal(8, 2)
  notes      String?
  subjectId  String?
  sectionId  String?
  teacherId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  subject  Subject?  @relation(fields: [subjectId], references: [id])
  section  Section?  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher  Teacher?  @relation(fields: [teacherId], references: [id])
  grades   Grade[]

  @@index([sectionId, subjectId, type])
  @@index([teacherId, type])
  @@map("exams")
}

// ─── Grades ─────────────────────────────────────────────────────────────

model Grade {
  id            String  @id @default(cuid())
  title           String?
  score           Decimal   @default(0) @db.Decimal(8, 2)
  maxScore        Decimal   @default(100) @db.Decimal(8, 2)
  examType        String
  term            String?   @default("first")
  date            DateTime  @default(now())
  notes           String?
  weight          Decimal?  @db.Decimal(8, 2)
  assessmentGroup String?
  isReviewed      Boolean   @default(false)
  warningLevel    String?
  studentId       String
  subjectId       String?
  teacherId       String?
  examId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])
  exam    Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([examId, studentId])
  @@index([studentId, subjectId, examType])
  @@index([subjectId, teacherId, examType])
  @@map("grades")
}

// ─── Class Fee Settings ─────────────────────────────────────────────────

model ClassFeeSetting {
  id            String  @id @default(cuid())
  classId       String
  amount        Decimal  @default(0) @db.Decimal(12, 2)
  uniformAmount Decimal  @default(0) @db.Decimal(12, 2)
  academicYear  String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  class SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, academicYear])
  @@map("class_fee_settings")
}

// ─── Payments ───────────────────────────────────────────────────────────

model Payment {
  id            String  @id @default(cuid())
  feeTitle        String?
  feeType         String    @default("tuition")
  amount          Decimal   @default(0) @db.Decimal(12, 2)
  status          String    @default("pending")
  method          String?
  academicYear    String?
  dueDate         DateTime?
  paidAt          DateTime?
  notes           String?
  originalAmount  Decimal?  @db.Decimal(12, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(12, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  discountReason  String?
  discountNotes   String?
  finalAmount     Decimal?  @db.Decimal(12, 2)
  remainingAmount Decimal?  @db.Decimal(12, 2)
  receiptNumber   String?   @unique
  studentId       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, academicYear, feeType])
  @@map("payments")
}

// ─── School Settings (single-row table) ─────────────────────────────────

model SchoolSetting {
  id                   String   @id @default("main")
  weekendDays          Json     @default("[\"friday\",\"saturday\"]")
  customHolidayDates   Json     @default("[]")
  checkoutWarningTime  String   @default("12:00")
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("school_settings")
}
